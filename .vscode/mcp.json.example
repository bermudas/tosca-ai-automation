{
  "servers": {
    "tosca-commander": {
      "type": "http",
      "url": "http://127.0.0.1:46248/mcp"
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    },
    "sap-gui": {
      "type": "stdio",
      "command": "uvx",
      "args": ["mcp-sap-gui[screenshots]", "--profile", "operator"]
    },
    "ToscaCloudMcpServer": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote@latest",
        "https://<YourTenant>.my.tricentis.com/<WorkspaceId>/_mcp/api/mcp",
        "56874",
        "--host",
        "127.0.0.1",
        "--static-oauth-client-info",
        "{\"client_id\":\"MCPServer\"}",
        "--static-oauth-client-metadata",
        "{\"scope\":\"tta\"}"
      ]
    }
  }
}
